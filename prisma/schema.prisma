// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
}

model QuoteCounter {
  shop  String
  year  Int
  value Int    @default(0)

  @@id([shop, year])
}

model ShopSettings {
  shop             String   @id
  companyName      String   @default("Besançon Archerie")
  legalForm        String   @default("SAS")
  shareCapital     String   @default("5 000 €")
  siren            String   @default("979 490 794")
  siret            String   @default("979 490 794 00018")
  vatNumber        String   @default("FR81979490794")
  address1         String   @default("25 Grande Rue")
  address2         String   @default("")
  postalCode       String   @default("25770")
  city             String   @default("Franois")
  country          String   @default("France")
  email            String   @default("")
  phone            String   @default("")
  website          String   @default("")
  additionalLegal  String   @default("")
  bankTransferInfo String   @default("Informations en cas de virement :\nIBAN : FR76 1080 7000 3312 5212 1202 213\nBIC : CCBPFRPPDJN")
  logoDataUrl      String   @default("")
  primaryColor     String   @default("#141F33")
  accentColor      String   @default("#D19E33")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Quote {
  id                    String      @id @default(cuid())
  shop                  String
  number                String
  status                QuoteStatus @default(DRAFT)
  customerShopifyId     String?
  customerName          String
  customerCompany       String?
  customerAddress1      String?
  customerAddress2      String?
  customerZip           String?
  customerCity          String?
  customerCountry       String?
  customerEmail         String?
  customerPhone         String?
  subtotalHt            Decimal     @db.Decimal(12, 2)
  vatTotal              Decimal     @db.Decimal(12, 2)
  discountTotal         Decimal     @db.Decimal(12, 2)
  globalDiscountPercent Decimal     @default(0) @db.Decimal(5, 2)
  globalDiscountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  totalTtc              Decimal     @db.Decimal(12, 2)
  shopifyDraftOrderId   String?
  shopifyOrderId        String?
  shopifyOrderName      String?
  convertedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  lines                 QuoteLine[]

  @@unique([shop, number])
  @@index([shop, createdAt])
}

model QuoteLine {
  id               String  @id @default(cuid())
  quoteId          String
  quote            Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position         Int
  title            String
  sku              String?
  shopifyVariantId String?
  quantity         Decimal @db.Decimal(10, 2)
  unitPriceTtc     Decimal @db.Decimal(12, 2)
  vatRate          Decimal @db.Decimal(5, 2)
  discountPercent  Decimal @db.Decimal(5, 2)
  discountType     String  @default("PERCENTAGE")
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  imageUrl         String?

  @@index([quoteId, position])
}
